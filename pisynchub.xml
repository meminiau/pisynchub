<?xml version="1.0"?>
<Container version="2">
  <Name>PiSyncHub</Name>
  <Repository>homerj007/pisynchub:latest</Repository>
  <Registry>https://hub.docker.com/r/homerj007/pisynchub</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/meminiau/pisynchub/issues</Support>
  <Project>https://github.com/meminiau/pisynchub</Project>
  <Overview>Unified multi-node dashboard and selective Teleporter backup/sync engine for Pi-hole v6.</Overview>
  <Category>Network:DNS</Category>
  <WebUI>http://[IP]:[PORT:8085]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/meminiau/pisynchub/main/icon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8085" Default="8085" Mode="tcp" Description="Port for the PiSyncHub Web Interface" Type="Port" Display="always" Required="true" Mask="false">8085</Config>
  <Config Name="Appdata Config" Target="/config" Default="/mnt/user/appdata/pisynchub" Mode="rw" Description="Persistent storage for nodes.json and Teleporter backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pisynchub</Config>
</Container>
